# vim:ft=plumed
UNITS NATURAL

# load interface for bias computation
LOAD FILE=../../../../PytorchKolmogorovBias.cpp

p: POSITION ATOM=1 NOPBC
ene: CUSTOM ARG=p.x,p.y PERIODIC=NO FUNC=3*exp(-x^2)*(exp(-(y-1./3.)^2)-exp(-(y-5./3.)^2))-5*exp(-y^2)*(exp(-(x-1.)^2)+exp(-(x+1.)^2))+0.2*x^4+0.2*(y-1./3.)^4

pot: BIASVALUE ARG=ene

# committor and committor-based bias
deep: PYTORCH_KOLMOGOROV_BIAS FILE=../../../models/transfer_z.pt ARG=p.x,p.y LAMBDA=1 EPSILON=1e-7 BETA=1 

# this is the total Kolmogorov bias, we express it on z for numerical reasons
BIASVALUE ARG=deep.kbias

# opes bias
opes: OPES_METAD_EXPLORE ARG=deep.z BARRIER=10 TEMP=1 PACE=200

lwall: LOWER_WALLS ARG=p.y KAPPA=1000 AT=-1.0
uwall: UPPER_WALLS ARG=p.y KAPPA=1000 AT=+2.0

PRINT STRIDE=200 ARG=* FILE=COLVAR
