# vim:ft=plumed
UNITS NATURAL
p: POSITION ATOM=1
ene: CUSTOM ARG=p.x,p.y PERIODIC=NO FUNC=3*exp(-x^2)*(exp(-(y-1./3.)^2)-exp(-(y-5./3.)^2))-5*exp(-y^2)*(exp(-(x-1.)^2)+exp(-(x+1.)^2))+0.2*x^4+0.2*(y-1./3.)^4

pot: BIASVALUE ARG=ene

lwall: LOWER_WALLS ARG=p.y KAPPA=1000 AT=-1.0
uwall: UPPER_WALLS ARG=p.y KAPPA=1000 AT=+2.0

PRINT STRIDE=200 ARG=* FILE=COLVAR
